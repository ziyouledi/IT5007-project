# Copy to .env: the server loads it on start, and variables already set in the shell win.
PORT=3001
# KAKI_DEV_ROUTES=1  # npm run dev already turns the /dev routes on; never set this for the demo server

# Shared LLM client (OpenAI-compatible, e.g. the school gateway). Leave unset to run without an LLM.
KAKI_LLM_BASE_URL=
KAKI_LLM_API_KEY=
KAKI_LLM_MODEL=
# KAKI_LLM_TIMEOUT_MS=20000

# Host: play scenarios/<id>/replay/transcript.json instead of live audio, optionally sped up.
# KAKI_REPLAY=1
# KAKI_REPLAY_SPEED=10
# KAKI_NOTETAKER_INTERVAL_MS=7000
